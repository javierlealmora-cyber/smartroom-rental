# ============================================================================
# E2E Tests — Staging environment
# Copiar a tests/e2e/.env.e2e y rellenar con valores reales
# NUNCA commitear .env.e2e con credenciales reales
# ============================================================================

# URL base de staging (sin barra final)
BASE_URL=https://staging.smartrentapp.com

# Credenciales de manager de prueba (cuenta real en staging)
TEST_MANAGER_EMAIL=e2e.manager@tudominio.com
TEST_MANAGER_PASSWORD=contraseña_segura

# Gestores por plan — casos de uso específicos de cada plan
# basic: max 1 entidad, 3 alojamientos, 20 habitaciones, sin branding
TEST_MANAGER_BASIC_EMAIL=e2e.basic@tudominio.com
TEST_MANAGER_BASIC_PASSWORD=contraseña_segura

# investor: max 5 entidades, 8 alojamientos, 60 habitaciones, con branding
TEST_MANAGER_INVESTOR_EMAIL=e2e.investor@tudominio.com
TEST_MANAGER_INVESTOR_PASSWORD=contraseña_segura

# business: max 10 entidades, alojamientos y habitaciones ilimitados, con branding
TEST_MANAGER_BUSINESS_EMAIL=e2e.business@tudominio.com
TEST_MANAGER_BUSINESS_PASSWORD=contraseña_segura

# agency: todo ilimitado, permite cambio de propietario (allows_owner_change)
TEST_MANAGER_AGENCY_EMAIL=e2e.agency@tudominio.com
TEST_MANAGER_AGENCY_PASSWORD=contraseña_segura

# Supabase staging (necesario para helpers que usan la API directamente)
VITE_SUPABASE_URL=https://lopdwrsmkmtboeczxotj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...tu_clave_anon_de_staging
